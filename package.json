{
  "name": "prisme",
  "version": "0.3.0",
  "description": "Understand any codebase, from beginner to senior developer: AI-written docs, diagrams and guided walks",
  "type": "module",
  "bin": {
    "prisme": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "LICENSE"
  ],
  "homepage": "https://github.com/a-diarrassouba/oh-my-mermaid-le-retour",
  "bugs": {
    "url": "https://github.com/a-diarrassouba/oh-my-mermaid-le-retour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-diarrassouba/oh-my-mermaid-le-retour.git"
  },
  "keywords": [
    "prisme",
    "architecture",
    "onboarding",
    "codebase",
    "diagram",
    "mermaid",
    "claude-code"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && vite build",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "check-version-sync": "node scripts/check-version-sync.js",
    "sync-version": "node scripts/sync-version.js",
    "prepublishOnly": "npm run build && npm run sync-version",
    "dev:web": "vite",
    "typecheck:web": "tsc -p web"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.4.17",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
